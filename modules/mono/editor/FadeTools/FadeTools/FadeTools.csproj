<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectGuid>{27B00618-A6F2-4828-B922-05CAEB08C286}</ProjectGuid>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <!-- The FADE editor uses the Debug FADE API assemblies -->
    <FADEApiConfiguration>Debug</FADEApiConfiguration>
    <FADESourceRootPath>$(SolutionDir)/../../../../</FADESourceRootPath>
    <FADEOutputDataDir>$(FADESourceRootPath)/bin/FADESharp</FADEOutputDataDir>
    <FADEApiAssembliesDir>$(FADEOutputDataDir)/Api/$(FADEApiConfiguration)</FADEApiAssembliesDir>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Needed for our source generators to work despite this not being a FADE game project -->
  <PropertyGroup>
    <IsFADEToolsProject>true</IsFADEToolsProject>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="IsFADEToolsProject" />
  </ItemGroup>

  <PropertyGroup Condition=" Exists('$(FADEApiAssembliesDir)/FADESharp.dll') ">
    <!-- The project is part of the FADE source tree -->
    <!-- Use the FADE source tree output folder instead of '$(ProjectDir)/bin' -->
    <OutputPath>$(FADEOutputDataDir)/Tools</OutputPath>
    <!-- Must not append '$(TargetFramework)' to the output path in this case -->
    <AppendTargetFrameworkToOutputPath>False</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2019.1.3.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="JetBrains.Rider.PathLocator" Version="1.0.12" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <Reference Include="FADESharp">
      <HintPath>$(FADEApiAssembliesDir)/FADESharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="FADESharpEditor">
      <HintPath>$(FADEApiAssembliesDir)/FADESharpEditor.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FADE.NET.Sdk\FADE.SourceGenerators\FADE.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\glue\FADESharp\FADE.SourceGenerators.Internal\FADE.SourceGenerators.Internal.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FADETools.BuildLogger\FADETools.BuildLogger.csproj" />
    <ProjectReference Include="..\FADETools.IdeMessaging\FADETools.IdeMessaging.csproj" />
    <ProjectReference Include="..\FADETools.ProjectEditor\FADETools.ProjectEditor.csproj" />
    <ProjectReference Include="..\FADETools.Core\FADETools.Core.csproj" />
  </ItemGroup>

</Project>
