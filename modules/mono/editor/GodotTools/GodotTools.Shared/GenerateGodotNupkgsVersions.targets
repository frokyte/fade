<Project>
  <!-- Generate C# file with the version of all the nupkgs bundled with FADE -->

  <Target Name="SetPropertiesForGenerateFADENupkgsVersions">
    <PropertyGroup>
      <GeneratedFADENupkgsVersionsFile>$(IntermediateOutputPath)FADENupkgsVersions.g.cs</GeneratedFADENupkgsVersionsFile>
    </PropertyGroup>
  </Target>

  <Target Name="GenerateFADENupkgsVersionsFile"
          DependsOnTargets="_GenerateFADENupkgsVersionsFile"
          BeforeTargets="PrepareForBuild;CompileDesignTime;BeforeCompile;CoreCompile">
    <ItemGroup>
      <Compile Include="$(GeneratedFADENupkgsVersionsFile)" />
      <FileWrites Include="$(GeneratedFADENupkgsVersionsFile)" />
    </ItemGroup>
  </Target>
  <Target Name="_GenerateFADENupkgsVersionsFile"
          DependsOnTargets="SetPropertiesForGenerateFADENupkgsVersions"
          Inputs="$(MSBuildProjectFile);$(MSBuildThisFileDirectory);$(MSBuildProjectFile)\..\..\..\SdkPackageVersions.props"
          Outputs="$(GeneratedFADENupkgsVersionsFile)">
    <PropertyGroup>
      <GenerateFADENupkgsVersionsCode><![CDATA[
namespace $(RootNamespace)
{
    public class GeneratedFADENupkgsVersions
    {
        public const string FADENETSdk = "$(PackageVersion_FADE_NET_Sdk)"%3b
        public const string FADESourceGenerators = "$(PackageVersion_FADE_SourceGenerators)"%3b
        public const string FADESharp = "$(PackageVersion_FADESharp)"%3b
    }
}
]]></GenerateFADENupkgsVersionsCode>
    </PropertyGroup>
    <WriteLinesToFile Lines="$(GenerateFADENupkgsVersionsCode)"
                      File="$(GeneratedFADENupkgsVersionsFile)"
                      Overwrite="True" WriteOnlyWhenDifferent="True" />
  </Target>
</Project>
