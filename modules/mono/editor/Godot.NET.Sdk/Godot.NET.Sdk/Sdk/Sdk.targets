<Project>
  <Import Sdk="Microsoft.NET.Sdk" Project="Sdk.targets" Condition="'$(FADESdkImportsMicrosoftNetSdk)' == 'true'" />

  <PropertyGroup>
    <!--
    Define constant to determine whether the real_t type in FADE is double precision or not.
    By default this is false, like the official FADE builds. If someone is using a custom
    FADE build where real_t is double, they can override the FADEFloat64 property.
    -->
    <DefineConstants Condition=" '$(FADEFloat64)' == 'true' ">GODOT_REAL_T_IS_DOUBLE;$(DefineConstants)</DefineConstants>
  </PropertyGroup>

  <!--
  We are defining ExportDebug and Debug in Sdk.targets to ensure that the user cannot
  override the DefineConstants property in their csproj file and break the editor functionality.
  -->
  <PropertyGroup>
    <!-- ExportDebug also defines DEBUG like Debug does. -->
    <DefineConstants Condition=" '$(Configuration)' == 'ExportDebug' ">$(DefineConstants);DEBUG</DefineConstants>
    <!-- Debug defines TOOLS to differentiate between Debug and ExportDebug configurations. -->
    <DefineConstants Condition=" '$(Configuration)' == 'Debug' ">$(DefineConstants);TOOLS</DefineConstants>

    <DefineConstants>$(_FADEDefineConstants);$(DefineConstants)</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableFADEDotNetPreview)' == 'true'">
    <DisableImplicitFADEGeneratorReferences>true</DisableImplicitFADEGeneratorReferences>
    <DisableImplicitFADESharpReferences>true</DisableImplicitFADESharpReferences>
  </PropertyGroup>

  <!-- FADESharp references -->
  <ItemGroup Condition=" '$(DisableImplicitFADEGeneratorReferences)' != 'true' ">
    <PackageReference Include="FADE.SourceGenerators" IsImplicitlyDefined="true" Version="$(PackageVersion_FADE_SourceGenerators)" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition=" '$(DisableImplicitFADESharpReferences)' != 'true' ">
    <PackageReference Include="FADESharp" IsImplicitlyDefined="true" Version="$(PackageVersion_FADESharp)" />
    <PackageReference Include="FADESharpEditor" IsImplicitlyDefined="true" Version="$(PackageVersion_FADESharp)" Condition=" '$(Configuration)' == 'Debug' " />
  </ItemGroup>
  <Target Name="CheckFADEDotNetReferences" BeforeTargets="Build" Condition=" '$(EnableFADEDotNetPreview)' != 'true' ">
    <Error Text="The project or one of its dependencies references FADE .NET packages which are incompatible with the active FADE C# bindings. The active C# bindings is FADESharp." Condition="$([System.String]::Copy('%(Reference.Identity)').Contains('FADE.Bindings.dll'))" />
  </Target>

  <!-- FADE .NET references -->
  <ItemGroup Condition=" '$(EnableFADEDotNetPreview)' == 'true' ">
    <PackageReference Include="FADE" IsImplicitlyDefined="true" Version="$(PackageVersion_FADEDotNet)" />
  </ItemGroup>
  <Target Name="CheckFADESharpReferences" BeforeTargets="Build" Condition=" '$(EnableFADEDotNetPreview)' == 'true' ">
    <Error Text="The project or one of its dependencies references FADESharp packages which is incompatible with the active FADE C# bindings. The active C# bindings is FADE .NET." Condition="$([System.String]::Copy('%(Reference.Identity)').Contains('FADESharp.dll'))" />
  </Target>

  <!-- iOS-specific build targets -->
  <Import Project="$(MSBuildThisFileDirectory)\iOS.targets" Condition=" '$(FADETargetPlatform)' == 'ios' " />

</Project>
