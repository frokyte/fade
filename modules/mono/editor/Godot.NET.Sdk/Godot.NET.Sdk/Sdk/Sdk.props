<Project>
  <Import Project="$(MSBuildThisFileDirectory)\SdkPackageVersions.props" />

  <PropertyGroup>
    <UsingFADENETSdk>true</UsingFADENETSdk>

    <!-- Determines if we should import Microsoft.NET.Sdk, if it wasn't already imported. -->
    <FADESdkImportsMicrosoftNetSdk Condition=" '$(UsingMicrosoftNETSdk)' != 'true' ">true</FADESdkImportsMicrosoftNetSdk>
  </PropertyGroup>

  <PropertyGroup>
    <Configurations>Debug;ExportDebug;ExportRelease</Configurations>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>

    <FADEProjectDir Condition=" '$(FADEProjectDir)' == '' ">$(MSBuildProjectDirectory)</FADEProjectDir>
    <FADEProjectDir>$([MSBuild]::EnsureTrailingSlash('$(FADEProjectDir)'))</FADEProjectDir>
    <FADEProjectDirBase64 Condition=" $([MSBuild]::VersionGreaterThanOrEquals($(MSBuildAssemblyVersion), '17.3')) ">$([MSBuild]::ConvertToBase64('$(FADEProjectDir)'))</FADEProjectDirBase64>

    <!-- Custom output paths for FADE projects. In brief, 'bin\' and 'obj\' are moved to '$(FADEProjectDir)\.godot\mono\temp\'. -->
    <BaseOutputPath>$(FADEProjectDir).godot\mono\temp\bin\</BaseOutputPath>
    <OutputPath>$(FADEProjectDir).godot\mono\temp\bin\$(Configuration)\</OutputPath>
    <!--
    Use custom IntermediateOutputPath and BaseIntermediateOutputPath only if it wasn't already set.
    Otherwise the old values may have already been changed by MSBuild which can cause problems with NuGet.
    -->
    <IntermediateOutputPath Condition=" '$(IntermediateOutputPath)' == '' ">$(FADEProjectDir).godot\mono\temp\obj\$(Configuration)\</IntermediateOutputPath>
    <BaseIntermediateOutputPath Condition=" '$(BaseIntermediateOutputPath)' == '' ">$(FADEProjectDir).godot\mono\temp\obj\</BaseIntermediateOutputPath>

    <!-- Do not append the target framework name to the output path. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <Target Condition=" $([MSBuild]::VersionLessThan($(MSBuildAssemblyVersion), '17.3')) " Name="FADEProjectDir" BeforeTargets="Build">
    <Error Text="Cannot build from path containing '%23', move your project or update dotnet to the latest version." Condition="$(FADEProjectDir.Contains('%23'))" /> <!-- # -->
    <Error Text="Cannot build from path containing '%3B', move your project or update dotnet to the latest version." Condition="$(FADEProjectDir.Contains('%3B'))" /> <!-- ; -->
    <Error Text="Cannot build from path containing newlines, move your project or update dotnet to the latest version." Condition="$(FADEProjectDir.Contains('%0A'))" /> <!-- \n -->
    <Error Text="Cannot build from path containing newlines, move your project or update dotnet to the latest version." Condition="$(FADEProjectDir.Contains('%0D'))" /> <!-- \r -->
  </Target>

  <Import Sdk="Microsoft.NET.Sdk" Project="Sdk.props" Condition=" '$(FADESdkImportsMicrosoftNetSdk)' == 'true' " />

  <PropertyGroup>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

  <!--
  The Microsoft.NET.Sdk only understands of the Debug and Release configurations.
  We need to set the following properties manually for ExportDebug and ExportRelease.
  -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' or '$(Configuration)' == 'ExportDebug' ">
    <DebugSymbols Condition=" '$(DebugSymbols)' == '' ">true</DebugSymbols>
    <Optimize Condition=" '$(Optimize)' == '' ">false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'ExportRelease' ">
    <Optimize Condition=" '$(Optimize)' == '' ">true</Optimize>
  </PropertyGroup>

  <PropertyGroup>
    <FADEApiConfiguration Condition=" '$(Configuration)' != 'ExportRelease' ">Debug</FADEApiConfiguration>
    <FADEApiConfiguration Condition=" '$(Configuration)' == 'ExportRelease' ">Release</FADEApiConfiguration>
  </PropertyGroup>

  <!-- Auto-detect the target FADE platform if it was not specified. -->
  <PropertyGroup Condition=" '$(FADETargetPlatform)' == '' ">
    <FADETargetPlatform Condition=" $(RuntimeIdentifier.StartsWith('ios')) ">ios</FADETargetPlatform>
    <FADETargetPlatform Condition=" '$(FADETargetPlatform)' == '' and $(RuntimeIdentifier.StartsWith('android')) ">android</FADETargetPlatform>
    <FADETargetPlatform Condition=" '$(FADETargetPlatform)' == '' and $(RuntimeIdentifier.StartsWith('browser')) ">web</FADETargetPlatform>

    <FADETargetPlatform Condition=" '$(FADETargetPlatform)' == '' and $(RuntimeIdentifier.StartsWith('linux')) ">linuxbsd</FADETargetPlatform>
    <FADETargetPlatform Condition=" '$(FADETargetPlatform)' == '' and $(RuntimeIdentifier.StartsWith('freebsd')) ">linuxbsd</FADETargetPlatform>
    <FADETargetPlatform Condition=" '$(FADETargetPlatform)' == '' and $(RuntimeIdentifier.StartsWith('osx')) ">macos</FADETargetPlatform>
    <FADETargetPlatform Condition=" '$(FADETargetPlatform)' == '' and $(RuntimeIdentifier.StartsWith('win')) ">windows</FADETargetPlatform>
  </PropertyGroup>

  <!-- Auto-detect the target FADE platform if it was not specified and there's no runtime identifier information. -->
  <PropertyGroup Condition=" '$(FADETargetPlatform)' == '' ">
    <FADETargetPlatform Condition=" '$([MSBuild]::IsOsPlatform(Linux))' ">linuxbsd</FADETargetPlatform>
    <FADETargetPlatform Condition=" '$([MSBuild]::IsOsPlatform(FreeBSD))' ">linuxbsd</FADETargetPlatform>
    <FADETargetPlatform Condition=" '$([MSBuild]::IsOsPlatform(OSX))' ">macos</FADETargetPlatform>
    <FADETargetPlatform Condition=" '$([MSBuild]::IsOsPlatform(Windows))' ">windows</FADETargetPlatform>
  </PropertyGroup>

  <PropertyGroup>
    <FADEFloat64 Condition=" '$(FADEFloat64)' == '' ">false</FADEFloat64>
  </PropertyGroup>

  <!-- FADE DefineConstants. -->
  <PropertyGroup>
    <!-- Define constants to identify FADE builds. -->
    <_FADEDefineConstants>GODOT</_FADEDefineConstants>

    <!--
    Define constant to determine the target FADE platform. This includes the
    recognized platform names and the platform category (PC, MOBILE or WEB).
    -->
    <_FADEPlatformConstants Condition=" '$(FADETargetPlatform)' == 'windows' ">GODOT_WINDOWS;GODOT_PC</_FADEPlatformConstants>
    <_FADEPlatformConstants Condition=" '$(FADETargetPlatform)' == 'linuxbsd' ">GODOT_LINUXBSD;GODOT_PC</_FADEPlatformConstants>
    <_FADEPlatformConstants Condition=" '$(FADETargetPlatform)' == 'macos' ">GODOT_OSX;GODOT_MACOS;GODOT_PC</_FADEPlatformConstants>
    <_FADEPlatformConstants Condition=" '$(FADETargetPlatform)' == 'android' ">GODOT_ANDROID;GODOT_MOBILE</_FADEPlatformConstants>
    <_FADEPlatformConstants Condition=" '$(FADETargetPlatform)' == 'ios' ">GODOT_IPHONE;GODOT_IOS;GODOT_MOBILE</_FADEPlatformConstants>
    <_FADEPlatformConstants Condition=" '$(FADETargetPlatform)' == 'web' ">GODOT_JAVASCRIPT;GODOT_HTML5;GODOT_WASM;GODOT_WEB</_FADEPlatformConstants>

    <_FADEDefineConstants>$(_FADEDefineConstants);$(_FADEPlatformConstants);$(_FADEVersionConstants)</_FADEDefineConstants>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)\Android.props" Condition=" '$(FADETargetPlatform)' == 'android' " />
  <Import Project="$(MSBuildThisFileDirectory)\iOS.props" Condition=" '$(FADETargetPlatform)' == 'ios' " />
</Project>
