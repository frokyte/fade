<?xml version="1.0" encoding="utf-8"?>
<resources>
	<style name="FADEEditorTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
	</style>

	<style name="FADEGameTheme" parent="FADEEditorTheme">
		<item name="android:windowIsTranslucent">true</item>
	</style>

	<style name="FADEEditorSplashScreenTheme" parent="Theme.SplashScreen.IconBackground">
		<!-- Set the theme of the Activity that directly follows your splash
		screen. This is required. -->
		<item name="postSplashScreenTheme">@style/FADEEditorTheme</item>
	</style>

	<style name="FADEEmbeddedGameTheme" parent="@android:style/Theme.DeviceDefault.Panel">
	</style>
</resources>
